{
  "name": "talon-deck",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "bin": {
    "talon-deck": "./cli.mjs"
  },
  "scripts": {
    "start": "node out/server/src/server/server.js",
    "build": "webpack --config webpack.config.cjs --mode production",
    "watch": "webpack serve --config webpack.config.cjs --mode development --port 9090",
    "client:dev": "vite --host --config src/client/vite.config.ts",
    "client:build": "vite build --config src/client/vite.config.ts",
    "client:preview": "vite preview --debug --config src/client/vite.config.ts",
    "server:dev": "ts-node src/server/server.ts",
    "server:build": "tsc --project src/server/tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.17",
    "basic-auth": "2.0.1",
    "cookie-parser": "^1.4.6",
    "csurf": "^1.11.0",
    "dayjs": "^1.11.5",
    "express": "^4.18.1",
    "helmet": "^5.1.1",
    "host-validation": "2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.5.1",
    "socket.io-client": "^4.5.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/core": "7.18.10",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "7.18.6",
    "@types/basic-auth": "1.1.3",
    "@types/cookie-parser": "^1.4.3",
    "@types/csurf": "^1.11.2",
    "@types/express": "^4.17.13",
    "@types/host-validation": "^2.0.1",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@types/socket.io-client": "^3.0.0",
    "@types/uuid": "^8.3.4",
    "@types/webpack-env": "^1.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.6.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.17",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "vite": "^6.2.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "3.0.0"
  }
}
